# Copy to .env for local overrides. Defaults already match docker-compose.yml.
REDIS_URL=redis://localhost:6381
MONGO_URL=mongodb://localhost:27018
CASSANDRA_HOST=localhost
CASSANDRA_PORT=9043

# Required, no default. Signs login tokens; keep it private. (docker compose up
# makes a random one for each run if this is empty; set it to keep logins across
# restarts.) Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

# Public address used to build short links (no trailing slash).
BASE_URL=http://localhost:8001
